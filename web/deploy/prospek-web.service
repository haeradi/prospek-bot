[Unit]
Description=Portal Prospek Web (companion to Telegram bot)
After=network-online.target team-leader-token-broker.service
Wants=network-online.target
Wants=team-leader-token-broker.service

[Service]
Type=simple
User=prospekweb
Group=prospekweb
WorkingDirectory=/opt/prospek-web
EnvironmentFile=/etc/prospek-web.env
Environment=PORTAL_DATA_DIR=/var/lib/prospek-web/data
Environment=TEAMLEADER_TOKEN_SOCKET=/run/prospek-web-token/broker.sock
StateDirectory=prospek-web
StateDirectoryMode=0700
ExecStart=/usr/local/lib/prospek-web/node /opt/prospek-web/src/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
MemoryMax=2G
TasksMax=512
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/prospek-web
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
