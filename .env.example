TG_TOKEN=your_telegram_bot_token_here

# Portal web (gunakan /etc/prospek-web.env permission 0600 di produksi)
PORTAL_ADMIN_EMAIL=admin@example.invalid
PORTAL_ADMIN_PASSWORD=replace-with-strong-password
ASSIST_MASTER_KEY=base64-32-byte-key
ASSIST_MUTATION_ENABLED=false
# Wajib false selama deploy/migration smoke; aktifkan hanya setelah review PASS.
ASSIST_PARITY_MUTATION_ENABLED=false
PORT=3210
